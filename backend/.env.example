# Shopify Backend Configuration
# Copia questo file in .env e riempilo con i tuoi dati Shopify

# Nome del tuo store Shopify
# Formato: my-store.myshopify.com oppure solo il nome: my-store
SHOPIFY_SHOP=your-store-name

# Client ID della tua app Shopify
# Puoi trovarlo in: Shopify Admin > Apps and integrations > Develop apps > Your app > Configuration
SHOPIFY_CLIENT_ID=your_shopify_client_id

# Client Secret della tua app Shopify
# ATTENZIONE: Tieni questo valore seguro! Non condividerlo!
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret

# Access Token per l'API
# Puoi generarlo in: Shopify Admin > Apps and integrations > Develop apps > Your app > Configuration > Admin API access tokens > Create token
# Assicurati di avere i permessi giusti:
# - read_products, write_products (per gestire prodotti)
# - read_orders, write_orders (per gestire ordini)
# - read_customers, write_customers (per gestire clienti)
# - read_inventory, write_inventory (per gestire inventario)
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxx

# (Opzionale) Chiave API per validazione webhooks
SHOPIFY_API_KEY=xxxxxxxxxxxxx

# Porta del server
PORT=3001

# Ambiente
NODE_ENV=development
